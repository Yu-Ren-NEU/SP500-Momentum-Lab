{
  "name": "sp500-momentum-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "update": "python3 scripts/update.py",
    "validate": "python3 scripts/validate_public.py",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py' && npm run test:ui",
    "check": "npm run validate && npm test && npm run build",
    "test:ui": "vitest run",
    "update:base": "python3 scripts/build_base.py",
    "download:base": "python3 scripts/build_base.py --download",
    "update:recent": "python3 scripts/extend_recent.py",
    "update:catalogue": "python3 scripts/build_top10_history.py",
    "audit:data": "python3 scripts/audit_integrity.py",
    "supplement:history": "python3 scripts/supplement_history.py",
    "update:benchmarks-ytd": "python3 scripts/update_benchmark_ytd.py --download",
    "update:price": "python3 scripts/build_price_base.py"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
